{
  "name": "agency-agents-sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK, CLI, and GitHub Action for loading agent personalities from msitarzewski/agency-agents and building multi-agent swarms. Ships no agent content of its own — fetches the roster from the source repo.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agency-agents": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node scripts/build-cjs.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test -- --run && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "node scripts/install-hooks.mjs",
    "release": "semantic-release"
  },
  "keywords": [
    "ai",
    "agents",
    "llm",
    "claude",
    "gpt",
    "orchestration",
    "swarm",
    "agency",
    "personality",
    "prompt-engineering"
  ],
  "author": "el-j",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/el-j/agency-agents-sdk.git"
  },
  "homepage": "https://github.com/el-j/agency-agents-sdk#readme",
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@vitest/coverage-v8": "^5.0.0",
    "oxlint": "^1.82.0",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
